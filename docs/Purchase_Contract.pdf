               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>RheinstraÃŸe 2 Mainz HRB 7498 DE 188 158 403</photoshop:LayerName>
                  <photoshop:LayerText>RheinstraÃŸe 2 Mainz HRB 7498 DE 188 158 403</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>SIGNATURE OF THE OWNER         </photoshop:LayerName>
                  <photoshop:LayerText>SIGNATURE OF THE OWNER         </photoshop:LayerText>
